# Copy to .env.local and fill in. Never commit real keys.

# AI Consultant widget (Gemini, server-side only).
GEMINI_API_KEY=
# Optional model override (default: gemini-flash-latest, Google's
# auto-updating stable-flash alias)
GEMINI_MODEL=

# Consultation form delivery via Resend — RESEND_API_KEY pending from owner.
RESEND_API_KEY=
CONSULT_TO_EMAIL=info@corewellsystems.com
# Optional; defaults to Resend's onboarding sender until the domain is
# verified in Resend, then e.g. "Corewell Systems <forms@corewellsystems.com>".
CONSULT_FROM_EMAIL=

# Canonical site URL. Production default is https://corewellsystems.com
# (hardcoded fallback in lib/site.ts); local dev sets http://localhost:3000.
NEXT_PUBLIC_SITE_URL=

# Plausible analytics — set to the site domain to enable the script.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# Full-system demo hosted outside this site (Corewell Trade). When set, the
# Retail demo page shows a link to it; unset simply hides the link.
# e.g. https://demo.corewellsystems.com
NEXT_PUBLIC_DEMO_TRADE_URL=
