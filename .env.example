# Copy to .env.local and fill in. Never commit real keys.

# AI Consultant widget (Gemini, server-side only) — owner will provide.
GEMINI_API_KEY=
# Optional model override (default: gemini-2.5-flash)
GEMINI_MODEL=

# Consultation form delivery via Resend — owner will provide.
RESEND_API_KEY=
CONSULT_TO_EMAIL=
# Optional; defaults to Resend's onboarding sender until a domain is verified.
CONSULT_FROM_EMAIL=

# Canonical site URL for metadata/sitemap/OG (set once domain is live).
NEXT_PUBLIC_SITE_URL=

# Plausible analytics — set to the site domain to enable the script.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
